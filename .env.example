# ZeroWork — 用户配置模型凭据请走应用内 ZeroCode API Key（写入 ~/.zerowork/config.toml BYOK）。
# 不要用下面的 ZAI_* / BIGMODEL_* 产品键作为应用主配置方式。
#
# 可选内部覆盖（代码默认已是空或 http://127.0.0.1:9；未跟踪的 .env.local 可显式填写）：
ZCODE_BASE_URL=
ZCODE_ENDPOINT_ORIGIN=
ZCODE_CDN_BASE_URL=
ZCODE_CONVERSATION_SHARE_WEB_URL=
ZCODE_REMOTE_ASSET_CDN_BASE_URL=
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
ZEROWORK_DATA_BASE_DIR=

# Legacy internal endpoint knobs — still accepted by code with loopback defaults.
# Not the user-facing API key path (see Welcome ZeroCode API Key → config.toml).
# BIGMODEL_API_BASE_URL=
# ZAI_OAUTH_ORIGIN=
# ZAI_BUSINESS_BASE_URL=
# ZAI_OAUTH_CLIENT_ID=
# ZAI_OAUTH_APP_ID=
